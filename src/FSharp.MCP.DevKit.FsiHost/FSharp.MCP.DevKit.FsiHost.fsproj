<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FsiActor.fs" />
    <Compile Include="SessionActor.fs" />
    <Compile Include="HostSupervisorActor.fs" />
    <Compile Include="Program.fs" />
    <None Include="akka.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FSharp.MCP.DevKit.Core\FSharp.MCP.DevKit.Core.fsproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.Messages\FSharp.MCP.DevKit.Messages.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.62" />
    <PackageReference Include="Akka.Remote" Version="1.5.62" />
  </ItemGroup>
</Project>
