<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.MCP.DevKit.Server</RootNamespace>
    <AssemblyName>FSharp.MCP.DevKit</AssemblyName>
    
    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsharp-mcp-server</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <EnableTestingPlatform>false</EnableTestingPlatform>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateTestingPlatformConfigurationFile>false</GenerateTestingPlatformConfigurationFile>
    
    <!-- Package Metadata -->
    <PackageId>FSharp.MCP.DevKit.Server</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageDescription>F# Model Context Protocol (MCP) development server with F# Interactive, code editing, and documentation tools</PackageDescription>
    <PackageAuthors>EHotwagner</PackageAuthors>
    <PackageTags>fsharp;mcp;model-context-protocol;ai;llm;tools;development</PackageTags>
    <PackageProjectUrl>https://github.com/EHotwagner/FSharp.MCP.DevKit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/EHotwagner/FSharp.MCP.DevKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Backends\IRemoteFsiClient.fs" />
    <Compile Include="Backends\IBackend.fs" />
    <Compile Include="Backends\BackendSelector.fs" />
    <Compile Include="Backends\BackendAdapters.fs" />
    <Compile Include="Integration\ProcSupervisorClient.fs" />
    <Compile Include="Integration\ProcSupervisorDiscovery.fs" />
    <Compile Include="Integration\FsiSupervisorClient.fs" />
    <Compile Include="Backends\InProcBackend.fs" />
    <Compile Include="Backends\NetFxHostBackend.fs" />
    <Compile Include="ControlPlane\RegistryContracts.fs" />
    <Compile Include="ControlPlane\AgentRegistry.fs" />
    <Compile Include="ControlPlane\HostRegistry.fs" />
    <Compile Include="ControlPlane\SessionRegistry.fs" />
    <Compile Include="ControlPlane\InventoryEventStore.fs" />
    <Compile Include="ControlPlane\OutputSubscriberBroker.fs" />
    <Compile Include="ControlPlane\AsyncJobRegistry.fs" />
    <Compile Include="ControlPlane\ResultRegistry.fs" />
    <Compile Include="ControlPlane\PathMappingRegistry.fs" />
    <Compile Include="ControlPlane\DefaultRouting.fs" />
    <Compile Include="ControlPlane\ControlPlaneDtos.fs" />
    <Compile Include="ControlPlane\ExecutionRouter.fs" />
    <Compile Include="ControlPlane\ProvisioningServices.fs" />
    <Compile Include="ResultQuery\ResultQueryTypes.fs" />
    <Compile Include="ResultQuery\ResultQueryService.fs" />
    <Compile Include="Backends\Net10HostBackend.fs" />
    <Compile Include="McpFsiTools.fs" />
    <Compile Include="McpControlPlaneTools.fs" />
    <Compile Include="McpExecutionTools.fs" />
    <Compile Include="McpResultTools.fs" />
    <Compile Include="McpClientHarness.fs" />
    <Compile Include="ControlPlaneResources.fs" />
    <Compile Include="ResultResources.fs" />
    <None Include="akka.server.conf" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="McpDocumentationTools.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../csharp-sdk/src/ModelContextProtocol.AspNetCore/ModelContextProtocol.AspNetCore.csproj" />
    <ProjectReference Include="../../../csharp-sdk/src/ModelContextProtocol/ModelContextProtocol.csproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.Core\FSharp.MCP.DevKit.Core.fsproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.Analysis\FSharp.MCP.DevKit.Analysis.fsproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.Communication\FSharp.MCP.DevKit.Communication.fsproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.CodeEditing\FSharp.MCP.DevKit.CodeEditing.fsproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.Documentation\FSharp.MCP.DevKit.Documentation.fsproj" />
    <ProjectReference Include="..\FSharp.MCP.DevKit.Messages\FSharp.MCP.DevKit.Messages.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.64" />
    <PackageReference Include="Akka.Remote" Version="1.5.64" />
    <PackageReference Include="FAkka.Fsi.Contracts" Version="10.1.201.5" />
    <PackageReference Include="FAkka.FSI.Supervisor" Version="1.564.101.201-win1" />
    <PackageReference Include="FAkka.Proc.Supervisor" Version="1.564.101.201-win1" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
    <PackageReference Include="Fantomas.Core" Version="7.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <!--<PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.1" />-->
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
