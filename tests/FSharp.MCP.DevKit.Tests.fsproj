<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\FSharp.MCP.DevKit.Core\FSharp.MCP.DevKit.Core.fsproj" />
    <ProjectReference Include="..\src\FSharp.MCP.DevKit.Analysis\FSharp.MCP.DevKit.Analysis.fsproj" />
    <ProjectReference Include="..\src\FSharp.MCP.DevKit.Communication\FSharp.MCP.DevKit.Communication.fsproj" />
    <ProjectReference Include="..\src\FSharp.MCP.DevKit.CodeEditing\FSharp.MCP.DevKit.CodeEditing.fsproj" />
    <ProjectReference Include="..\src\FSharp.MCP.DevKit.Messages\FSharp.MCP.DevKit.Messages.fsproj" />
    <ProjectReference Include="..\src\FSharp.MCP.DevKit.Server\FSharp.MCP.DevKit.Server.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BackendSelectorTests.fs" />
    <Compile Include="BackendAdaptersTests.fs" />
    <Compile Include="ControlPlaneTests.fs" />
    <Compile Include="ExecutionRouterTests.fs" />
    <Compile Include="FsiMcpServiceTests.fs" />
    <Compile Include="InProcBackendTests.fs" />
    <Compile Include="McpSurfaceTests.fs" />
    <Compile Include="NetFxHostBackendTests.fs" />
    <Compile Include="Net10HostBackendTests.fs" />
    <Compile Include="ProvisioningServicesTests.fs" />
    <Compile Include="RemoteMessageContractTests.fs" />
    <Compile Include="SmartSymbolDetectionServiceTests.fs" />
  </ItemGroup>

</Project>
