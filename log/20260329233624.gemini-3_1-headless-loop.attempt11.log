{"type":"tool_result","timestamp":"2026-03-30T00:07:12.979Z","tool_id":"run_shell_command_1774829232731_1","status":"success","output":"#if INTERACTIVE\n#I @\"/workspace/home/work/sharftrade7/實驗/SharFTrade.Exp/bin/net10.0\"\n#r \"PersistedConcurrentSortedList.dll\"\n#r \"DynamicObj.dll\"\n#r \"Plotly.NET.dll\"\n#r \"FAkka.Shared.dll\"\n#r \"Skender.Stock.Indicators.dll\"\n#r \"SharFTrade.Exp.2025.dll\"\n#r \"MdcFsClient90.dll\"\n#r \"FSharp.Collections.ParallelSeq.dll\";;\n#r \"Argu.dll\";;\n#endif\n\nopen System\nopen System.IO\nopen System.Collections.Generic\nopen Plotly.NET\nopen PersistedConcurrentSortedList\n//open PersistedConcurrentSortedList.Type\nopen Skender.Stock.Indicators\nopen CFar\nopen FAkka.TA\nopen TAType;;\nopen FAkka.TA.FAkkaQuote\nopen FAkka.Trading.FAnalytica\nopen FriceSeries9.FAkkaChartMod2\n\ntype QuoteBar(minKey: int64, o: decimal, h: decimal, l: decimal, c: decimal, v: decimal) =\n    let dt =\n        DateTime(\n            int (minKey / 100000000L),\n            int ((minKey / 1000000L) % 100L),\n            int ((minKey / 10000L) % 100L),\n            int ((minKey / 100L) % 100L),\n            int (minKey % 100L),\n            0\n        )\n\n    interface IQuote with\n        member _.Open = o\n        member _.High = h\n        member _.Low = l\n        member _.Close = c\n        member _.Volume = v\n\n    interface ISeries with\n        member _.Date = dt\n\nlet repoRoot = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, \"..\"))\n\nlet resolvePcslRoot () =\n    [ Environment.GetEnvironmentVariable \"SHARFTRADE_PCSL_ROOT\"\n      Environment.GetEnvironmentVariable \"CFAR_PCSL_ROOT\"\n      \"/workspace/home/vhdx/cFar_pcsl2/cFar2\"\n      \"/workspace/home/vhdx/cFar_pcsl2\"\n      @\"H:\\cFar2\"\n      @\"h:\\cFar2\" ]\n    |> Seq.choose (fun path ->\n        if String.IsNullOrWhiteSpace path then None\n        else\n            let full = Path.GetFullPath path\n            if Directory.Exists full then Some full else None)\n    |> Seq.tryHead\n    |> function\n        | Some root -> root\n        | None -> failwith \"PCSL root not found. Set SHARFTRADE_PCSL_ROOT or copy data under /workspace/home/vhdx/cFar_pcsl2/cFar2.\"\n\nlet root = resolvePcslRoot ()\nlet scale = 5s\nlet limitCount = 1500\nlet output = Path.Combine(repoRoot, \"es_5k_dmi_macd_preview.html\")\n\nlet trimTail (arr: 'T[]) =\n    arr |> Array.skip (max 0 (arr.Length - limitCount))\n\nlet cfar = CFar(root, (\"CME\", \"ES\"), allKeyPair, 1)"}
